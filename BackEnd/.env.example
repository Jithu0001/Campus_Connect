# --- Required ---------------------------------------------------------------
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The two secrets MUST be different from each other and at least 32 characters.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# --- Optional (defaults shown) ---------------------------------------------
PORT=8000
MONGO_URI=mongodb://localhost:27017/Campus_Connect
NODE_ENV=development

# Comma-separated list of frontend origins allowed to call the API.
# REQUIRED when NODE_ENV=production. Example: https://campus-connect.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Number of reverse proxies in front of the app (Render = 1). Keep 0 locally.
TRUST_PROXY=0

#For email alerts
EMAIL_FROM=@gmail.com
BREVO_API_KEY=

# For cloud image uplodation
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

